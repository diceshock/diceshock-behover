page { --brand-green: #7efba9; --ink: #000; --paper: #fff; --border: #dce5de;
  background: #f3f6f2; color: var(--ink); font-size: 28rpx; line-height: 1.5; }
.page { padding: 24rpx 28rpx 64rpx; }
.brand-bar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.brand-wordmark { display: block; width: 176rpx; height: 47.7rpx; }
.brand-account, .filter-toggle { margin: 0; padding: 12rpx 20rpx; border: 1rpx solid var(--border);
  border-radius: 99rpx; background: var(--paper); font-size: 24rpx; font-weight: 600; min-height: 72rpx; line-height: 1.4;
  display: flex; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; }
.filter-toggle { width: 132rpx; min-width: 0; padding-left: 8rpx; padding-right: 8rpx; }
.hero { padding: 30rpx; border-radius: 24rpx; background: #101412; color: var(--paper); margin-bottom: 24rpx; }
.home-hero { background: var(--brand-green); color: var(--ink); }
.mailbox-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx;
  text-decoration: none; font-size: 34rpx; line-height: 1.3; }
.mailbox-title { display: block; font-weight: 700; margin-bottom: 4rpx; }
.mailbox-message { display: block; width: 100%; margin: 12rpx 0; }
.history-card { display: block; width: 100%; text-align: left; font-weight: 400; line-height: 1.5; }
.kicker { font-size: 24rpx; font-weight: 600; letter-spacing: 1rpx; color: var(--brand-green); }
.home-hero .kicker { color: var(--ink); }
.title { display: block; font-size: 46rpx; font-weight: 750; line-height: 1.25; margin: 6rpx 0 8rpx; overflow-wrap: anywhere; }
.section { font-size: 32rpx; font-weight: 700; line-height: 1.35; margin: 26rpx 0 14rpx; }
.card { background: var(--paper); border: 1rpx solid var(--border); border-radius: 20rpx; padding: 24rpx; margin: 14rpx 0; }
.card-title { font-size: 32rpx; font-weight: 700; line-height: 1.35; margin: 6rpx 0; overflow-wrap: anywhere; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.stack > view { margin-top: 14rpx; }
.muted { color: #45534a; font-size: 26rpx; line-height: 1.55; }
.hero .muted { color: #c7d5ca; }
.home-hero .muted { color: #183824; }
.tag { display: inline-block; background: #def9e7; color: #17442a; border-radius: 99rpx; padding: 6rpx 16rpx; font-size: 24rpx; }
.session-meta { align-items: baseline; flex-wrap: wrap; margin-top: 10rpx; }
.session-fee { font-size: 25rpx; font-weight: 800; }
.error { background: #fbe2db; color: #812c20; border-radius: 14rpx; padding: 16rpx; margin: 16rpx 0; }
.body { line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.label { display: block; font-weight: 650; margin: 20rpx 0 8rpx; }
input, textarea, .picker { box-sizing: border-box; background: #edf3ee; border: 1rpx solid var(--border); border-radius: 12rpx; width: 100%;
  font-family: inherit; font-size: 28rpx; color: var(--ink); text-align: left; }
/* Native inputs center their editable line; vertical padding shifts that line. */
input { height: 76rpx; padding: 0 14rpx; line-height: normal; }
.picker { display: flex; align-items: center; min-height: 76rpx; padding: 14rpx; line-height: 1.5; overflow-wrap: anywhere; }
/* Multiline content starts at the top, with consistent space around the text. */
textarea { min-height: 140rpx; padding: 14rpx; line-height: 1.5; }
/* Reset the native button line-height; align labels independently of height. */
button { display: flex; align-items: center; justify-content: center; box-sizing: border-box;
  min-height: 88rpx; padding: 16rpx 24rpx; line-height: 1.4; text-align: center;
  white-space: normal; overflow-wrap: break-word;
  background: #e3ece5; color: #101412; margin: 14rpx 0; font-weight: 600;
  border-radius: 14rpx; font-size: 28rpx; }
button.primary { color: var(--ink); background: var(--brand-green); }
button[disabled] { opacity: .65; }
button::after { border: 0; }
.split { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 14rpx; }
.demo { text-align: center; padding: 8rpx; font-size: 22rpx; color: #365043; background: #e2efe5; }
.branch-card { display: flex; align-items: center; justify-content: flex-start; gap: 12rpx; width: 100%; min-height: 122rpx; padding: 16rpx;
  text-align: left; margin: 0; border: 1rpx solid var(--border); border-radius: 20rpx; background: var(--paper); }
.branch-card.is-selected { border-color: #101412; box-shadow: inset 0 0 0 1rpx #101412; }
.branch-art { display: grid; place-items: center; flex: 0 0 88rpx; height: 88rpx; overflow: hidden; border-radius: 12rpx; background: #f3f6f2; }
.branch-cover { width: 88rpx; height: 88rpx; }
.branch-mark { display: block; width: 66rpx; height: 66rpx; }
.optics-art { width: 78rpx; height: 78rpx; position: relative; background: var(--paper); }
.optics-lightning { position: absolute; left: 7.47%; top: 7.47%; width: 58.94%; height: 85.06%; }
.optics-wordmark { position: absolute; left: 3.44%; top: 35.98%; width: 93.12%; height: 28.04%; }
.branch-info { min-width: 0; }
.branch-name, .branch-count, .branch-address { display: block; line-height: 1.45; }
.branch-count, .branch-address { color: #45534a; font-size: 24rpx; font-weight: 400; }
.branch-address { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.branch-name { font-size: 28rpx; font-weight: 700; }
.chips { display: flex; gap: 12rpx; flex-wrap: wrap; }
.filter-chips { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }
.chip { display: flex; align-items: center; justify-content: center; line-height: 1.4; text-align: center; box-sizing: border-box; flex: 0 0 auto; width: auto; margin: 0; border-radius: 99rpx; padding: 0 24rpx; font-size: 25rpx; min-height: 68rpx; }
.filter-chips .chip { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; height: 68rpx; padding: 0 8rpx; line-height: 1.2; text-align: center; }
.chip.primary { background: #101412; color: var(--paper); }
.recruitment-list { margin-top: 20rpx; }
.recruitment-day + .recruitment-day { margin-top: 24rpx; }
.recruitment-date { margin: 0 0 10rpx; padding: 8rpx 14rpx; border-radius: 8rpx; background: #e3ece5;
  color: #20362c; font-size: 26rpx; font-weight: 700; }
.session-tags { margin: 8rpx 0; gap: 6rpx; }
.session-tags .tag { padding: 2rpx 12rpx; line-height: 1.5; overflow-wrap: anywhere; }
.recruitment-card { display: grid; align-items: stretch; justify-content: normal; grid-template-columns: minmax(0,1fr) minmax(118rpx,auto); gap: 14rpx; width: 100%; text-align: left; margin: 0 0 4rpx; padding: 20rpx; color: #20362c; background: #fcfaf2; border: 1px solid #ded6c3; border-radius: 0; font-size: 26rpx; font-weight: 400; line-height: 1.5; }
.recruitment-card::after { border: 0; }
.recruitment-info { min-width: 0; overflow-wrap: anywhere; }
.recruitment-time { color: #17442a; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.recruitment-seats { border-left: 1px dashed #b8b29e; padding-left: 12rpx; align-self: stretch; display: flex; flex-direction: column; justify-content: center; text-align: center; font-weight: 700; }
.recruitment-seats .muted { font-size: 24rpx; font-weight: 400; }

.pricing-guide { border-color: #b6d5bf; }
.pricing-row { display: flex; align-items: flex-start; gap: 20rpx; margin: 16rpx 0; line-height: 1.5; }
.pricing-name { flex: 0 0 128rpx; font-weight: 700; }
.pricing-ticket { padding: 16rpx; margin-top: 20rpx; border-radius: 12rpx; background: #e3ece5; font-size: 25rpx; line-height: 1.6; }

.panel {background:#fff;border:1rpx solid #dce5de;border-radius:20rpx;padding:24rpx;margin:14rpx 0;}
.heading {font-size:32rpx;font-weight:700;margin:14rpx 0;}
.actions,.tags {display:flex;gap:14rpx;flex-wrap:wrap;}
.empty,.notice {padding:20rpx;color:#45534a;}
.notice {background:#def9e7;border-radius:14rpx;}
.eyebrow,.price {color:#17442a;font-size:26rpx;}
.store-image,.reward-cover {width:100%;height:240rpx;border-radius:14rpx;}
.privacy-overlay {position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:center;padding:28rpx;}
.privacy-dialog {width:100%;}

/* style v2 sets a fixed width on native buttons without [size]. Keep the
   original full-width recruitment cards and compact filter controls. */
.page button:not([size='mini']) { width: 100%; margin-left: 0; margin-right: 0; }
.page .chips button.chip { width: auto; }
.page button.recruitment-card { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.page button.filter-toggle { width: 132rpx; padding: 12rpx 8rpx; }
.page button.branch-card { width: 100%; }
.page .filter-chips button.chip { width: 100%; padding: 0 8rpx; }

.brand-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.brand-actions .brand-account { padding: 12rpx 16rpx; white-space: nowrap; }
.brand-bar .brand-wordmark { flex-shrink: 1; min-width: 100rpx; }
