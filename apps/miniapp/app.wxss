page {
  background: #f5f5f5;
  color: #18181b;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.heading {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  margin-bottom: 32rpx;
}

.panel {
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: #52525b;
  font-size: 26rpx;
}

.eyebrow {
  color: #117747;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.body {
  white-space: pre-wrap;
  overflow-wrap: break-word;
  margin-top: 24rpx;
}

button {
  min-height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin: 16rpx 0 0;
  color: #18181b;
  background: #f4f4f5;
}

button::after {
  border: none;
}

button.primary {
  background: #36ffa1;
  color: #071b12;
}

button[disabled] {
  background: #e4e4e7;
  color: #71717a;
}

button.link {
  color: #117747;
  background: transparent;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.actions button {
  flex: 1;
}

input {
  background: #fafafa;
  border: 1rpx solid #d4d4d8;
  border-radius: 10rpx;
  height: 88rpx;
  padding: 0 20rpx;
  margin: 16rpx 0;
}

.picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e4e4e7;
}

.error {
  color: #991b1b;
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.notice {
  color: #14532d;
  background: #f0fdf4;
  padding: 20rpx;
  margin: 16rpx 0;
  border-radius: 10rpx;
}

.empty {
  padding: 48rpx 24rpx;
  color: #52525b;
  text-align: center;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 16rpx 0;
}

.tag {
  background: #f4f4f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #52525b;
  font-size: 24rpx;
}

.store-image {
  display: block;
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
}

.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(0,0,0,.5);
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.privacy-dialog {
  flex: 1;
}
