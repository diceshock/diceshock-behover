{
  "name": "diceshock-miniapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wv dev",
    "build:local": "wv build --mode acceptance",
    "build:release": "wv build",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "check": "pnpm run typecheck && biome check --error-on-warnings ."
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typed-document-node": "^7.0.3",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.13.1",
    "miniprogram-api-typings": "^5.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "weapp-vite": "^7.11.0"
  }
}
