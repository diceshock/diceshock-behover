<view class="page"><view class="section">发起新团</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{busy}}" class="muted">正在处理…</view><block wx:if="{{ready}}"><view class="card">
 <view class="label">门店</view><picker disabled="{{!!form.id || busy}}" range="{{stores}}" range-key="name" value="{{storeIndex}}" data-key="storeIndex" bindchange="pick"><view class="picker">{{stores[storeIndex].name}} ▾</view></picker>
 <view class="label">场次标题</view><input value="{{form.title}}" data-key="title" bindinput="field" maxlength="100"/><view class="label">模组名称（选填）</view><input value="{{form.moduleName}}" data-key="moduleName" bindinput="field" maxlength="100"/><view class="label">规则系统</view><input value="{{form.gameSystem}}" data-key="gameSystem" bindinput="field" maxlength="40"/>
 <view class="label">介绍与玩家须知</view><textarea value="{{form.description}}" data-key="description" bindinput="field" maxlength="1000" auto-height/>
 <view class="label">团类型</view><picker range="{{types}}" value="{{typeIndex}}" data-key="typeIndex" bindchange="pick"><view class="picker">{{types[typeIndex]}} ▾</view></picker>
 <view class="split"><view><view class="label">席位上限（1–6）</view><input value="{{form.capacity}}" data-key="capacity" bindinput="field" type="number"/></view><view><view class="label">成团人数（1–6）</view><input value="{{form.minimum}}" data-key="minimum" bindinput="field" type="number"/></view></view>
 <view class="label">预计时长（分钟）</view><input value="{{form.durationMinutes}}" data-key="durationMinutes" bindinput="field" type="number"/><view class="label">标签（逗号分隔，最多 8 个）</view><input value="{{form.tags}}" data-key="tags" bindinput="field" maxlength="167"/>
 </view><view class="card"><view class="row"><text class="card-title">确定开团时间</text><switch checked="{{scheduled}}" disabled="{{!stores[storeIndex].id}}" bindchange="toggle" color="#17442a"/></view>
 <block wx:if="{{scheduled && stores[storeIndex].id}}"><view class="label">包间或大厅</view><picker range="{{tables}}" range-key="name" value="{{tableIndex}}" data-key="tableIndex" bindchange="pick"><view class="picker">{{tables[tableIndex].name || '暂无可用包间'}} ▾</view></picker>
 <view class="label">开团时间（北京时间）</view><view class="split"><picker mode="date" value="{{date}}" data-key="date" bindchange="pick"><view class="picker">{{date || '选择日期'}}</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="pick"><view class="picker">{{time}}</view></picker></view>
 <view class="label">报名截止</view><view class="split"><picker mode="date" value="{{cutoffDate}}" data-key="cutoffDate" bindchange="pick"><view class="picker">{{cutoffDate || '选择日期'}}</view></picker><picker mode="time" value="{{cutoffTime}}" data-key="cutoffTime" bindchange="pick"><view class="picker">{{cutoffTime}}</view></picker></view></block>
 <block wx:else><view class="label">意向时间（选填）</view><input value="{{form.timeHint}}" data-key="timeHint" bindinput="field" maxlength="40"/><view class="muted">{{stores[storeIndex].id ? '时间待定的场次可先收集玩家意向。' : '地点待定：人齐后再协商门店、包间与时间。'}}</view></block></view>
 <view class="muted">{{stores[storeIndex].canReview && !form.id ? '管理人员发布后公开展示。' : '提交后由管理员或店长审核，通过后公开展示。'}}</view><button class="primary" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">{{stores[storeIndex].canReview && !form.id ? '发布场次' : '提交审核'}}</button></block></view>