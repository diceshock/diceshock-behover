<view class="page">
  <view class="section">我的账户</view>
  <view wx:if="{{!loggedIn}}" class="panel">
    <view class="muted">登录后查看报名进度与已结团记录。</view>
    <button class="primary" bindtap="login">微信登录</button>
  </view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button bindtap="reload">重试</button>
    <button bindtap="login">重新登录</button>
  </view>
  <view wx:if="{{profile}}" class="panel">
    <view class="heading">{{profile.nickname}}</view>
    <view class="row"><text class="card-title">会员账户</text><text class="tag">两店通用</text></view><view class="split"><view><text class="muted">余额</text><view class="card-title">¥{{profile.balanceText}}</view></view><view><text class="muted">积分</text><view class="card-title">{{profile.points}}</view></view></view><navigator url="/pages/rewards/index" class="label">积分兑换商城 ›</navigator><navigator url="/pages/mailbox/index" class="label">我的公会来信 ›</navigator>
    <navigator wx:if="{{profile.canHost}}" url="/pages/workbench/index" class="card"><view class="card-title">{{profile.canManage ? "门店管理" : "主持工作台"}} ›</view><view class="muted">{{profile.canManage ? "发布场次 · 场次审核 · 报名管理" : "发起新团 · 查看进度 · 报名名单"}}</view></navigator>
        <button wx:if="{{profile.canManage || profile.canHost}}" bindtap="scanLogin" disabled="{{busy}}">扫码登录电脑后台</button>
    <button bindtap="logout" disabled="{{busy}}">退出登录</button>
  </view>
  <block wx:if="{{loggedIn}}">
    <view class="actions">
      <button class="{{!archive ? 'primary' : ''}}" data-archive="no" bindtap="changeMode" disabled="{{busy}}">我的报名</button>
      <button class="{{archive ? 'primary' : ''}}" data-archive="yes" bindtap="changeMode" disabled="{{busy}}">已结团</button>
    </view>
    <view wx:if="{{busy}}" class="empty">正在加载…</view>
    <view wx:if="{{!busy && !error && !records.length}}" class="empty">暂无{{archive ? '已结团' : '报名'}}记录</view>
    <session-card wx:for="{{records}}" wx:key="id" session="{{item}}"/>
    <button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">加载更多</button>
  </block>
</view>
