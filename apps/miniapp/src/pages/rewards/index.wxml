<view class="page">
  <view class="hero"><text class="kicker">DICESHOCK · 会员福利</text><text class="title">积分兑换商城</text><view class="muted">两店通用</view><view wx:if="{{points !== null}}" class="muted">可用积分：{{points}}</view><button wx:if="{{!loggedIn}}" bindtap="login">登录并验证手机号后兑换 ›</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button><button bindtap="login">重新登录</button></view>
  <view class="section">可兑换福利</view><view wx:if="{{busy && !offers.length}}" class="card muted">正在加载商品…</view><view wx:if="{{!busy && !error && !offers.length}}" class="card muted">暂无可兑换商品。</view>
  <view wx:for="{{offers}}" wx:key="id" class="card"><image wx:if="{{item.cover}}" class="reward-cover" src="{{item.cover}}" mode="aspectFit"/><view class="row"><text class="card-title">{{item.title}}</text><text class="tag">{{item.points}} 积分</text></view><view class="muted">{{item.description}}</view><button wx:if="{{loggedIn}}" class="primary" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy || points === null || item.stock < 1 || points < item.points}}">{{item.stock < 1 ? '已兑完' : '兑换'}}</button></view>
  <view wx:if="{{loggedIn}}" class="section">我的兑换券</view><view wx:if="{{loggedIn && !vouchers.length && !busy && !error}}" class="card muted">暂无兑换券。</view>
  <view wx:for="{{vouchers}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.title}}</text><text class="tag">{{item.usedAt ? '已核销' : '待核销'}}</text></view><view class="muted">{{item.points}} 积分</view><view wx:if="{{item.usedAt}}" class="muted">核销：{{item.usedStore}} · {{item.usedLabel}}</view><view wx:else class="muted">两店通用 · 到店出示此券，由店员核销。</view><button data-id="{{item.id}}" bindtap="copy">复制完整券号</button></view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">更多兑换券</button>
</view>
