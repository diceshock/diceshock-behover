<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{busy}}" class="muted">正在加载…</view><block wx:if="{{store}}"><view class="hero"><text class="kicker">DICESHOCK · 到店指引</text><text class="title">{{store.name}}</text></view><view class="card"><view class="card-title">门店地址</view><view class="body">{{store.address || '请联系门店确认地址'}}</view><button wx:if="{{store.address}}" bindtap="copy">复制地址</button><view wx:if="{{media.hours}}" class="muted">营业时间：{{media.hours}}</view><image wx:if="{{media.image}}" class="store-image" src="{{media.image}}" mode="widthFix" bindtap="preview" binderror="imageError"/><view wx:if="{{media.guide}}" class="body">{{media.guide}}</view><button wx:if="{{media.phone}}" bindtap="call">联系门店</button><button wx:if="{{media.wechat}}" bindtap="wechat">复制门店微信</button></view></block></view>
