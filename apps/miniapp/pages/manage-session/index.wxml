<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="reload">刷新</button></view><view wx:if="{{busy}}" class="muted">正在处理…</view><block wx:if="{{session}}">
 <view class="hero"><view class="title">{{session.title}}</view><view>{{session.statusText}} · {{session.storeName}}</view></view><view class="card"><view>{{session.hostName}} · {{session.gameSystem}}</view><view>{{session.timeText}} · {{session.durationMinutes}} 分钟</view><view>{{session.tableName || '包间待定'}} · {{session.feeText}}</view><view class="muted">报名截止：{{session.deadlineText}}</view><view class="description">{{session.description}}</view><view wx:if="{{session.reason}}" class="error">原因：{{session.reason}}</view></view>
 <button wx:if="{{session.canEdit}}" bindtap="edit" class="primary">修改并重新提交</button>
 <view wx:if="{{session.canReview}}" class="card"><view class="card-title">场次管理</view><view wx:if="{{session.status === 'pending'}}" class="split"><button class="primary" data-action="approve" bindtap="action" disabled="{{busy}}">审核通过并发布</button><button data-action="return" bindtap="action" disabled="{{busy}}">退回修改</button></view><view wx:if="{{session.status === 'published'}}" class="split"><button data-action="cancel" bindtap="action" disabled="{{busy}}">流团</button><button data-action="complete" bindtap="action" disabled="{{busy || !session.startsAt}}">结团</button></view></view>
 <view wx:if="{{(session.canReview || !session.storeId) && session.status === 'published' && !session.startsAt}}" class="card"><view class="card-title">{{session.storeId ? '确定排期' : '确定地点与排期'}}</view><view wx:if="{{!session.storeId}}" class="label">门店</view><picker wx:if="{{!session.storeId}}" range="{{stores}}" range-key="name" value="{{storeIndex}}" data-key="storeIndex" bindchange="pick"><view class="picker">{{stores[storeIndex].name || '选择门店'}} ▾</view></picker><view class="label">包间或大厅</view><picker range="{{tables}}" range-key="name" value="{{tableIndex}}" data-key="tableIndex" bindchange="pick"><view class="picker">{{tables[tableIndex].name || '选择包间'}} ▾</view></picker><view class="label">开团时间（北京时间）</view><view class="split"><picker mode="date" value="{{date}}" data-key="date" bindchange="pick"><view class="picker">{{date || '选择日期'}}</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="pick"><view class="picker">{{time}}</view></picker></view><view class="label">报名截止</view><view class="split"><picker mode="date" value="{{cutoffDate}}" data-key="cutoffDate" bindchange="pick"><view class="picker">{{cutoffDate || '选择日期'}}</view></picker><picker mode="time" value="{{cutoffTime}}" data-key="cutoffTime" bindchange="pick"><view class="picker">{{cutoffTime}}</view></picker></view><button class="primary" bindtap="schedule" disabled="{{busy}}">确认排期</button></view>
 <view class="section">报名名单 · 已确认 {{session.confirmedCount}} / {{session.capacity}}</view><view wx:if="{{!items.length}}" class="empty">暂无报名</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.nickname}}</text><text class="tag">{{item.statusText}}</text></view><view wx:if="{{item.phone}}">{{item.phone}}</view><view wx:if="{{item.reason}}" class="muted">{{item.reason}}</view><view wx:if="{{session.canReview && item.status === 'pending' && session.status === 'published'}}" class="split"><button class="primary" data-id="{{item.id}}" data-decision="approve" bindtap="review" disabled="{{busy}}">确认费用并通过</button><button data-id="{{item.id}}" data-decision="reject" bindtap="review" disabled="{{busy}}">退回</button></view></view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">更多报名</button></block></view>